# ─────────────────────────────────────────────────────────────
# Qarrai Academy — SERVER secrets for the Edge Functions (copy to supabase/functions/.env)
# Local:  loaded automatically by `npx supabase start` / `npx supabase functions serve`
# Hosted: npx supabase secrets set --env-file supabase/functions/.env
# NEVER commit the real file. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
# ─────────────────────────────────────────────────────────────

# ── Organisers' OpenAI-compatible API ────────────────────────
# Base URL including the version path, e.g. https://api.example.org/v1  (/chat/completions is appended)
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# Model identifiers — check them with:  curl -H "Authorization: Bearer $AI_API_KEY" $AI_BASE_URL/models
MODEL_FAST=llama3.2-3b
MODEL_DRAFT=qwen2.5-3b
MODEL_VALIDATOR=llama3.1-8b
MODEL_WRITING=mistral-7b
MODEL_CODER=qwen2.5-coder-7b
MODEL_OCR=deepseek-ocr
AI_ENABLE_CLASSIFIER=true

# ── Kill switch & abuse protection ───────────────────────────
# true = every AI call is refused immediately (also: UPDATE system_flags SET enabled=false WHERE key='ai_enabled')
AI_KILL_SWITCH=false
AI_MAX_OUTPUT_TOKENS=900
AI_REQUEST_DEADLINE_MS=120000
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_HOUR=60
RATE_LIMIT_IP_PER_MINUTE=30
DAILY_TOKEN_BUDGET=150000
ABUSE_BLOCK_THRESHOLD=5
DOCUMENTS_PER_DAY=30

# ── Web security ─────────────────────────────────────────────
# Comma-separated list of exact origins allowed to call the functions (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Random secret used to hash client IPs for rate limiting (generate: openssl rand -hex 24)
IP_HASH_SALT=

# Public URL of the web app (used in guardian invitation emails)
SITE_URL=http://localhost:5173
