# ─────────────────────────────────────────────────────────────
# Qarrai Academy — FRONTEND configuration (copy to .env)
# Only PUBLIC values belong here: they are compiled into the browser bundle.
# The anon key is public by design; Row Level Security protects every table.
# ─────────────────────────────────────────────────────────────

# Local:  run `npx supabase status` and copy "API URL" and "anon key"
# Hosted: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secrets (AI keys, service role key) DO NOT go here.
# They go in supabase/functions/.env — see supabase/functions/.env.example
